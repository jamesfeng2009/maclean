{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "maclean",
  "version": "0.3.0",
  "identifier": "com.maclean.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "maclean",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "category": "Utility",
    "icon": [
      "icons/icon.png"
    ]
  }
}
