[
  {
    "id": "browser-chromium-cache",
    "name_key": "rule_browser_chromium_cache",
    "desc_key": "rule_browser_chromium_cache_desc",
    "category": "浏览器缓存",
    "platform": "all",
    "roots": [
      "$HOME/Library/Caches/Google/Chrome/Default",
      "$HOME/Library/Caches/Google/Chrome/Profile *",
      "$HOME/Library/Caches/Microsoft Edge/Default",
      "$HOME/Library/Caches/BraveSoftware/Brave-Browser/Default",
      "$HOME/AppData/Local/Google/Chrome/User Data/Default",
      "$HOME/AppData/Local/Microsoft/Edge/User Data/Default"
    ],
    "patterns": [
      "Cache",
      "GPUCache",
      "Code Cache",
      "Service Worker/CacheStorage",
      "ShaderCache"
    ],
    "min_size": 52428800,
    "risk": "Safe",
    "required_stopped_processes": [
      "Google Chrome",
      "Chromium"
    ]
  },
  {
